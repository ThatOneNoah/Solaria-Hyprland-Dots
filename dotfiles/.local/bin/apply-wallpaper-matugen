#!/usr/bin/env bash
set -u

WALL="${1:-}"
LOG="/tmp/apply-wallpaper-matugen.log"

if [[ -z "$WALL" || ! -f "$WALL" ]]; then
  echo "Usage: apply-wallpaper-matugen /path/to/wallpaper" >&2
  exit 1
fi

start_daemon() {
  local name="$1"
  shift

  pgrep -x "$name" >/dev/null 2>&1 || {
    setsid "$@" >/dev/null 2>&1 < /dev/null &
    sleep 0.4
  }
}

set_wallpaper() {
  if command -v swww >/dev/null 2>&1; then
    if command -v swww-daemon >/dev/null 2>&1; then
      start_daemon swww-daemon swww-daemon
    fi
    swww img "$WALL" --transition-type any --transition-fps 120 --transition-duration 0.6
    return
  fi

  if command -v awww >/dev/null 2>&1; then
    if command -v awww-daemon >/dev/null 2>&1; then
      start_daemon awww-daemon awww-daemon
    fi
    awww img "$WALL" --transition-type any --transition-fps 120 --transition-duration 0.6 --resize crop
    return
  fi

  if command -v hyprctl >/dev/null 2>&1 && pgrep -x hyprpaper >/dev/null 2>&1; then
    hyprctl hyprpaper wallpaper ",$WALL"
    return
  fi

  echo "No supported wallpaper backend found. Install swww, awww, or run hyprpaper." >&2
  return 1
}

mkdir -p "$HOME/.config/nwg-dock-hyprland"
mkdir -p "$HOME/.config/quickshell"
mkdir -p "$HOME/.config/hypr"
mkdir -p "$HOME/.config/mako"
mkdir -p "$HOME/.config/eww"
mkdir -p "$HOME/.config/ghostty"

: > "$LOG"

# 1) Wallpaper
if ! set_wallpaper >>"$LOG" 2>&1; then
  notify-send "Wallpaper failed" "Could not set $(basename "$WALL"). See $LOG" 2>/dev/null || true
  exit 1
fi

ln -sf "$WALL" "$HOME/.config/hypr/current_wallpaper"

# 2) Generate colors
if command -v matugen >/dev/null 2>&1; then
  COLOR_WALL="$WALL"
  COLOR_TMP=""
  WALL_MIME="$(file -b --mime-type "$WALL" 2>/dev/null || true)"

  if [[ "$WALL_MIME" == "image/gif" ]] && command -v magick >/dev/null 2>&1; then
    COLOR_TMP="/tmp/matugen-wallpaper-frame.png"
    if magick "${WALL}[0]" "$COLOR_TMP" >>"$LOG" 2>&1; then
      COLOR_WALL="$COLOR_TMP"
    fi
  fi

  matugen image --source-color-index 0 "$COLOR_WALL" >>"$LOG" 2>&1 || {
    printf 'matugen failed for %s\n' "$WALL" >>"$LOG"
    notify-send "Wallpaper set" "Colors were not updated for $(basename "$WALL")." 2>/dev/null || true
  }

  [[ -n "$COLOR_TMP" ]] && rm -f "$COLOR_TMP"
fi

# 3) Restart Quickshell with the same explicit config Hyprland autostarts.
pkill -x quickshell >/dev/null 2>&1 || true
pkill -x qs >/dev/null 2>&1 || true
sleep 0.2

if command -v qs >/dev/null 2>&1; then
  qs -d -p "$HOME/.config/quickshell/shell.qml" >/tmp/quickshell.log 2>&1 || true
elif command -v quickshell >/dev/null 2>&1; then
  quickshell -d -p "$HOME/.config/quickshell/shell.qml" >/tmp/quickshell.log 2>&1 || true
fi

# 4) Reload notifications and desktop widgets so they track matugen colors.
makoctl reload >/dev/null 2>&1 || {
  pgrep -x mako >/dev/null 2>&1 || nohup mako >/tmp/mako.log 2>&1 &
}

if command -v eww >/dev/null 2>&1; then
  eww daemon >/tmp/eww.log 2>&1 || true
  eww reload >/tmp/eww-reload.log 2>&1 || true
  eww open desktop_time >/tmp/eww-open.log 2>&1 || true
fi

# nwg-dock-hyprland no longer autostarts; the Quickshell side bar owns apps.
# bash "$HOME/.local/bin/reload-dock-hypr.sh" >/dev/null 2>&1 || true

# 5) Optional: reload Hyprland config parsing
hyprctl reload >/dev/null 2>&1 || true

# 6) Optional: update pywalfox if installed
if command -v pywalfox >/dev/null 2>&1; then
  pywalfox update >/tmp/pywalfox.log 2>&1 || true
fi
