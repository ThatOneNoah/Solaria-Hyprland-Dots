#!/usr/bin/env bash
set -euo pipefail

WALL_DIR="__HOME__/Pictures/WALLPAPERS"
THUMB_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/walls/thumbs"
PREVIEW_CLASS="rofi-wall-preview"
PREVIEW_GEOM="900x520+1040+200"  # width x height +X +Y; adjust to sit next to rofi
mkdir -p "$THUMB_DIR"

thumb_for() {
  local img="$1"
  local base; base="$(basename "$img")"
  local out="$THUMB_DIR/${base%.*}.png"
  if [[ ! -f "$out" || "$img" -nt "$out" ]]; then
    magick "$img" -thumbnail 512x288^ -gravity center -extent 512x288 "$out"
  fi
  printf '%s' "$out"
}

# generate pywal -> rofi colors template once
TPL="$HOME/.config/wal/templates/colors-rofi.rasi"
if [[ ! -f "$TPL" ]]; then
cat >"$TPL" <<'EOF'
/* Auto-generated by pywal */
* {
  background: #{background};
  foreground: #{foreground};
  color0: #{color0};
  color1: #{color1};
  color2: #{color2};
  color3: #{color3};
  color4: #{color4};
  color5: #{color5};
  color6: #{color6};
  color7: #{color7};
}
EOF
fi

# ROFI script-mode:
#  - ROFI_RETV=0 -> print entries
#  - ROFI_RETV=1 -> user pressed Enter
#  - ROFI_RETV=10/11/12 -> kb-custom-1/2/3 (preview/random/set+exit)

case "${ROFI_RETV:-0}" in
  0)
    shopt -s nullglob
    for img in "$WALL_DIR"/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}; do
      name="$(basename "$img")"
      icon="$(thumb_for "$img")"
      printf '%s\0icon\x1f%s\0info\x1f%s\n' "$name" "$icon" "$img"
    done | sort -f
    ;;
  1|12)
    IMG="${ROFI_INFO:-}"
    [[ -n "$IMG" && -f "$IMG" ]] || exit 1
    swww img "$IMG" --transition-type grow --transition-duration 0.65
    wal -n -i "$IMG"
    # poke things to reload
    pkill -USR2 waybar 2>/dev/null || true
    pkill -USR1 wofi 2>/dev/null || true
    # optional: wal-gtk-theme -a >/dev/null 2>&1 || true
    if [[ "${ROFI_RETV:-}" == "12" ]]; then exit 0; fi
    echo -n "$IMG"
    ;;
  10) # preview (Ctrl+P)
    IMG="${ROFI_INFO:-}"
    [[ -n "$IMG" && -f "$IMG" ]] || exit 0
    # kill old preview if any
    pkill -f "imv --class $PREVIEW_CLASS" 2>/dev/null || true
    # show a floating preview window (sway/Hyprland will float by rule)
    imv --class "$PREVIEW_CLASS" --geometry "$PREVIEW_GEOM" "$IMG" >/dev/null 2>&1 &
    # pass selection back so rofi stays
    echo -n "$IMG"
    ;;
  11) # random (Ctrl+R)
    mapfile -t FILES < <(find "$WALL_DIR" -maxdepth 1 -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.webp" \))
    [[ ${#FILES[@]} -gt 0 ]] || exit 0
    IMG="${FILES[$RANDOM % ${#FILES[@]}]}"
    swww img "$IMG" --transition-type grow --transition-duration 0.65
    wal -n -i "$IMG"
    pkill -USR2 waybar 2>/dev/null || true
    pkill -USR1 wofi 2>/dev/null || true
    echo -n "$IMG"
    ;;
esac
