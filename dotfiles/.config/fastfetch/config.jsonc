{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": " -> " // évite les ":" entre clé et valeur
  },
  "modules": [
    {
      "type": "custom",
      "format": "{##ffbe76} /$$$$$$  /$$$$$$$   /$$$$$$  /$$   /$$         /$$$$$$$  /$$$$$$$$ /$$      /$${#}"
    },
    {
      "type": "custom",
      "format": "{##ffbe76} /$$__  $$| $$__  $$ /$$__  $$| $$  | $$        | $$__  $$|__  $$__/| $$  /$ | $${#}"
    },
    {
      "type": "custom",
      "format": "{##ffbe76}| $$  \\ $$| $$  \\ $$| $$  \\__/| $$  | $$        | $$  \\ $$   | $$   | $$ /$$$| $${#}"
    },
    {
      "type": "custom",
      "format": "{##ffbe76}| $$$$$$$$| $$$$$$$/| $$      | $$$$$$$$ /$$$$$$| $$$$$$$    | $$   | $$/$$ $$ $${#}"
    },
    {
      "type": "custom",
      "format": "{##ffbe76}| $$__  $$| $$__  $$| $$      | $$__  $$|______/| $$__  $$   | $$   | $$$$_  $$$${#}"
    },
    {
      "type": "custom",
      "format": "{##ffbe76}| $$  | $$| $$  \\ $$| $$    $$| $$  | $$        | $$  \\ $$   | $$   | $$$/ \\  $${#}"
    },
    {
      "type": "custom",
      "format": "{##ffbe76}| $$  | $$| $$  | $$|  $$$$$$/| $$  | $$        | $$$$$$$/   | $$   | $$/   \\  $${#}"
    },
    {
      "type": "custom",
      "format": "{##ffbe76}|__/  |__/|__/  |__/ \\______/ |__/  |__/        |_______/    |__/   |__/     \\__/{#}"
    },
    {
      "type": "custom",
      "format": "{##304774}╭───────────────────────╮{#}"
    },
    {
      "type": "os",
      "key": "{##ffbe76} {#}"
    },
    {
      "type": "kernel",
      "key": "{##ffbe76} {#}"
    },
    {
      "type": "packages",
      "key": "{##ffbe76} 󰮯{#}"
    },
    {
      "type": "shell",
      "key": "{##ffbe76} {#}"
    },
    {
      "type": "wm",
      "key": "{##ffbe76} 󰹑",
      "format": "{1}"
    },
    {
      "type": "terminal",
      "key": "{##ffbe76} ",
      "format": "{1}"
    },
    {
      "type": "uptime",
      "key": "{##ffbe76} {#}"
    },
    {
      "type": "custom",
      "format": "{##304774}╰───────────────────────╯{#}"
    },
  ]
}
