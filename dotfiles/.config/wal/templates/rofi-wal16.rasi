/* Generated by pywal16 – Noah layout */

* {
    background-color: {background};
    text-color:       {foreground};
    accent:           {color4};
    border-color:     {color1};
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    transparency:     "real";
    padding:          20px;
    width:            55%;
    height:           60%;
    border:           2px;
    border-color:     @border-color;
    location:         center;
    children:         [ mainbox ];
}

mainbox {
    spacing:  10px;
    padding:  10px;
    orientation: vertical;
    children: [ inputbar, content, mode-switcher ];
}

/* Top search bar */
inputbar {
    padding:       8px 12px;
    border:        1px;
    border-radius: 8px;
    border-color:  @accent;
    children:      [ prompt, entry ];
}

prompt {
    text-color: @accent;
    padding:    0 8px 0 0;
}

entry {
    expand: true;
}

/* Middle: preview + list */

content {
    orientation: horizontal;
    spacing: 10px;
    children: [ preview-box, listview ];
}

/* Left big preview panel – shows current wallpaper as background */
textbox-preview {
    expand: true;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    text-color:       @foreground;
    padding:          12px;
    border-radius:    12px;
}

preview-box {
    expand: true;
    orientation: vertical;
    children: [ textbox-preview ];
    border-radius: 12px;
    border: 1px;
    border-color: @border-color;
}

/* Right side list */
listview {
    fixed-height: false;
    expand:       true;
    spacing:      4px;
    scrollbar:    true;
    padding:      4px;
}

element {
    padding:       4px 8px;
    border-radius: 8px;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
}

element normal.normal {
    background-color: rgba(0,0,0,0);
    text-color:       @text-color;
}

element selected normal {
    background-color: @accent;
    text-color:       {background};
}

/* Bottom mode buttons: APPS / WALLPAPERS */

mode-switcher {
    padding:       8px 0 0 0;
    spacing:       10px;
    orientation:   horizontal;
    children:      [ button-0, button-1 ];
    horizontal-align: 0.5;
}

button {
    padding:       6px 18px;
    border-radius: 999px;
    border:        1px;
    border-color:  @border-color;
    text-color:    @text-color;
}

button selected {
    background-color: @accent;
    text-color:       {background};
}

@import "~/.cache/wal/rofi-preview-wallpaper.rasi"
